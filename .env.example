# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — он указан в .gitignore.

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Строка подключения к базе, которую проверяют тесты.
# Формат: postgresql+psycopg2://<пользователь>:<пароль>@<хост>:<порт>/<база>
dataBaseUrl=
